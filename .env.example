# Brevo directo: usa EMAIL_HOST=smtp-relay.brevo.com, EMAIL_PORT=587,
# EMAIL_USE_TLS=True y EMAIL_USE_SSL=False. Usa login y clave SMTP de Brevo.
# Si Brevo presenta un certificado para su alias histórico, verifica primero
# TLS con EMAIL_HOST=smtp-relay.sendinblue.com; nunca desactives su validación.
SERVER_EMAIL=ventas@imporgasjj.com
SERVER_EMAIL_APLICACION=serviciotecnico@imporgasjj.com
