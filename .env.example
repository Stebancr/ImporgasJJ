# Django / PostgreSQL persistente (proporcionar valores reales localmente)
SECRET_KEY=
DEBUG=True
DB_ENGINE=django.db.backends.postgresql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=postgres
DB_PORT=5432
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:81,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost,http://localhost:81,http://localhost:3000
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# Wompi: nunca exponer claves privadas en Vite/React
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
WOMPI_API_URL=https://sandbox.wompi.co/v1
WOMPI_HTTP_TIMEOUT=10

# Firebase Admin: usar archivo secret o las variables individuales
FIREBASE_CREDENTIALS_FILE=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_CLIENT_ID=
FIREBASE_CLIENT_CERT_URL=

# SMTP
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_SSL=False
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@example.com
EMAIL_TIMEOUT=30

# Producción: el relay definido en emails/docker-compose.yml comparte la red
# frontend_shared_net con el backend. Levántalo aparte y usa estos valores.
# EMAIL_HOST=smtp
# EMAIL_PORT=587
# EMAIL_USE_SSL=False
# EMAIL_USE_TLS=False
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# Ollama
OLLAMA_API_URL=http://ollama:11434/api/chat
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT=90
OLLAMA_NUM_CTX=4096
OLLAMA_ECOMMERCE_ENABLED=True

# Límites ajustables
THROTTLE_ANON_RATE=60/min
THROTTLE_USER_RATE=300/min
THROTTLE_LOGIN_RATE=5/min
THROTTLE_CHAT_RATE=20/min
THROTTLE_META_WEBHOOK_RATE=600/min
THROTTLE_META_ADMIN_RATE=20/min

# Meta Graph API (solo backend; nunca use estas variables con prefijo VITE_)
META_GRAPH_API_URL=https://graph.facebook.com
META_GRAPH_API_VERSION=v26.0
META_APP_ID=1614887440170255
META_HTTP_TIMEOUT=15
META_WEBHOOK_MAX_BYTES=2097152
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
META_CREDENTIALS_ENCRYPTION_KEY=
META_TOKEN_WARNING_DAYS=7
META_REDIRECT_URI=https://crm.example.com/api/meta/callback/
META_OAUTH_AUTHORIZE_URL=https://www.facebook.com
META_OAUTH_STATE_MAX_AGE=600
META_OAUTH_SCOPES=pages_show_list,pages_read_engagement,pages_manage_metadata,pages_messaging,instagram_basic,instagram_manage_messages
META_OAUTH_FRONTEND_REDIRECT=/admin/chat/integraciones
CRM_ATTACHMENT_MAX_BYTES=26214400
CRM_ATTACHMENT_MAX_REDIRECTS=3

# Instagram Business Login. Sustituya el dominio por el HTTPS publico real.
INSTAGRAM_OAUTH_REDIRECT_URI=https://crm.example.com/api/meta/instagram/oauth/callback/
INSTAGRAM_OAUTH_AUTHORIZE_URL=https://www.instagram.com/oauth/authorize
INSTAGRAM_OAUTH_TOKEN_URL=https://api.instagram.com/oauth/access_token
INSTAGRAM_GRAPH_API_URL=https://graph.instagram.com
INSTAGRAM_OAUTH_SCOPES=instagram_business_basic,instagram_business_manage_messages
INSTAGRAM_OAUTH_STATE_MAX_AGE=600

# Tiempo real y tareas del CRM dentro de la red Docker
CHANNEL_REDIS_URL=redis://redis:6379/2
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
