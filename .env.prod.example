# Copiar como .env.prod directamente en el servidor y aplicar chmod 600.
# Nunca confirmar .env.prod en Git.

# Django
SECRET_KEY=
DEBUG=False
DJANGO_LOG_LEVEL=INFO
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=1
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# PostgreSQL. POSTGRES_* inicializa el contenedor y DB_* conecta Django.
POSTGRES_DB=imporgas_db
POSTGRES_USER=
POSTGRES_PASSWORD=
DB_ENGINE=django.db.backends.postgresql
DB_NAME=imporgas_db
DB_USER=
DB_PASSWORD=
DB_HOST=postgres
DB_PORT=5432

# Redis, Channels y Celery
REDIS_URL=redis://redis:6379/1
CHANNEL_REDIS_URL=redis://redis:6379/2
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_TIME_LIMIT=120
CELERY_TASK_SOFT_TIME_LIMIT=110

# Ollama interno
OLLAMA_API_URL=http://ollama:11434/api/chat
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT=90
OLLAMA_NUM_CTX=4096
OLLAMA_ECOMMERCE_ENABLED=True

# Wompi producción. Las cuatro credenciales deben pertenecer al mismo comercio
# y ambiente. La llave privada no es requerida por el flujo actual.
WOMPI_PUBLIC_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
WOMPI_API_URL=https://production.wompi.co/v1
WOMPI_HTTP_TIMEOUT=10
VITE_WOMPI_PUBLIC_KEY=

# Meta Graph API. No habilitar plantillas, campañas ni envíos proactivos.
META_GRAPH_API_URL=https://graph.facebook.com
META_GRAPH_API_VERSION=v26.0
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_CREDENTIALS_ENCRYPTION_KEY=
META_REDIRECT_URI=https://djsolutions.io/api/meta/callback/
META_OAUTH_AUTHORIZE_URL=https://www.facebook.com
META_OAUTH_FRONTEND_REDIRECT=/admin/chat/integraciones
META_OAUTH_STATE_MAX_AGE=600
META_OAUTH_SCOPES=pages_show_list,pages_read_engagement,pages_manage_metadata,pages_messaging,instagram_basic,instagram_manage_messages
INSTAGRAM_OAUTH_REDIRECT_URI=https://djsolutions.io/api/meta/instagram/oauth/callback/
INSTAGRAM_OAUTH_AUTHORIZE_URL=https://www.instagram.com/oauth/authorize
INSTAGRAM_OAUTH_TOKEN_URL=https://api.instagram.com/oauth/access_token
INSTAGRAM_GRAPH_API_URL=https://graph.instagram.com
INSTAGRAM_OAUTH_SCOPES=instagram_business_basic,instagram_business_manage_messages
INSTAGRAM_OAUTH_STATE_MAX_AGE=600
META_HTTP_TIMEOUT=15
META_WEBHOOK_MAX_BYTES=2097152
META_TOKEN_WARNING_DAYS=7
CRM_ATTACHMENT_MAX_BYTES=26214400
CRM_ATTACHMENT_MAX_REDIRECTS=3

# SMTP real. Activar SSL para 465 o TLS para 587, nunca ambos.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_SSL=False
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
EMAIL_TIMEOUT=30

# Firebase opcional. Use las variables individuales sin exponerlas al frontend.
FIREBASE_CREDENTIALS_FILE=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_CLIENT_ID=
FIREBASE_CLIENT_CERT_URL=

# Límites y throttling
DATA_UPLOAD_MAX_MEMORY_SIZE=26214400
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
DATA_UPLOAD_MAX_NUMBER_FIELDS=1000
THROTTLE_ANON_RATE=60/min
THROTTLE_USER_RATE=300/min
THROTTLE_LOGIN_RATE=5/min
THROTTLE_CHAT_RATE=20/min
THROTTLE_REVIEW_RATE=30/min
THROTTLE_PAYMENT_RATE=30/min
THROTTLE_FCM_RATE=30/min
THROTTLE_WOMPI_WEBHOOK_RATE=240/min
THROTTLE_META_WEBHOOK_RATE=600/min
THROTTLE_META_ADMIN_RATE=20/min
