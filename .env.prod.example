# Copiar como .env.prod directamente en el servidor y aplicar chmod 600.
# Nunca confirmar .env.prod en Git.

# Django
SECRET_KEY=
DEBUG=False
DJANGO_LOG_LEVEL=INFO
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=1
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# PostgreSQL. POSTGRES_* inicializa el contenedor y DB_* conecta Django.
POSTGRES_DB=imporgas_db
POSTGRES_USER=
POSTGRES_PASSWORD=
DB_ENGINE=django.db.backends.postgresql
DB_NAME=imporgas_db
DB_USER=
DB_PASSWORD=
DB_HOST=postgres
DB_PORT=5432

# Redis, Channels y Celery
REDIS_URL=redis://redis:6379/1
CHANNEL_REDIS_URL=redis://redis:6379/2
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_TIME_LIMIT=120
CELERY_TASK_SOFT_TIME_LIMIT=110

# Ollama interno
OLLAMA_API_URL=http://ollama:11434/api/chat
FRONTEND_PUBLIC_URL=https://www.imporgasjj.com
VITE_PUBLIC_APP_URL=https://www.imporgasjj.com
VITE_API_URL=/api
PRODUCT_URL_TEMPLATE=https://www.imporgasjj.com/producto/{id}
EXTERNAL_PRODUCT_URL_TEMPLATE=https://www.imporgasjj.com/producto/{id}
CHATBOT_PRODUCT_RECOMMENDATIONS_ENABLED=False
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT=60
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_QUEUE=64
OLLAMA_NUM_PREDICT=180
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NO_CLOUD=1
OLLAMA_ECOMMERCE_ENABLED=True

# Wompi producción. Las cuatro credenciales deben pertenecer al mismo comercio
# y ambiente. La llave privada no es requerida por el flujo actual.
WOMPI_PUBLIC_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
WOMPI_API_URL=https://production.wompi.co/v1
WOMPI_HTTP_TIMEOUT=10
VITE_WOMPI_PUBLIC_KEY=

# Meta Graph API. No habilitar plantillas, campañas ni envíos proactivos.
META_GRAPH_API_URL=https://graph.facebook.com
META_GRAPH_API_VERSION=v26.0
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_VERIFY_TOKEN_INSTAGRAM=
META_WEBHOOK_VERIFY_TOKEN_FACEBOOK=
META_WEBHOOK_VERIFY_TOKEN_WHATSAPP=
META_CREDENTIALS_ENCRYPTION_KEY=
META_REDIRECT_URI=https://www.imporgasjj.com/api/meta/callback/
META_PUBLIC_BASE_URL=https://www.imporgasjj.com
META_FACEBOOK_WEBHOOK_URL=https://www.imporgasjj.com/api/meta/facebook/webhook/
META_INSTAGRAM_WEBHOOK_URL=https://www.imporgasjj.com/api/meta/instagram/webhook/
META_WHATSAPP_WEBHOOK_URL=https://www.imporgasjj.com/api/meta/whatsapp/webhook/
META_OAUTH_AUTHORIZE_URL=https://www.facebook.com
META_OAUTH_FRONTEND_REDIRECT=/admin/chat/integraciones
META_OAUTH_STATE_MAX_AGE=600
META_OAUTH_SCOPES=pages_show_list,pages_read_engagement,pages_manage_metadata,pages_messaging,instagram_basic,instagram_manage_messages
META_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
META_WHATSAPP_EMBEDDED_SIGNUP_VERSION=4
META_WHATSAPP_EMBEDDED_SIGNUP_STATE_MAX_AGE=600
CRM_INTERNAL_SERVICE_TOKEN=
WHATSAPP_GATEWAY_URL=http://whatsapp-gateway:3001
WHATSAPP_GATEWAY_CONNECTION_ID=primary
WHATSAPP_GATEWAY_ENV=production
WHATSAPP_GATEWAY_PORT=3001
WHATSAPP_AUTH_DIR=/app/auth
WHATSAPP_MEDIA_DIR=/app/media
WHATSAPP_GATEWAY_PUBLIC_URL=https://www.imporgasjj.com
WHATSAPP_GATEWAY_MAX_MEDIA_BYTES=26214400
WHATSAPP_GATEWAY_REQUEST_MAX_AGE=300
WHATSAPP_QR_TTL_SECONDS=60
WHATSAPP_MAX_MEDIA_BYTES=26214400
INSTAGRAM_OAUTH_REDIRECT_URI=https://www.imporgasjj.com/api/meta/instagram/oauth/callback/

# Clientes móviles. El código cliente debe leer estas variables según el entorno.
API_BASE_URL=https://www.imporgasjj.com/api/
API_PUBLIC_URL=https://www.imporgasjj.com/api/
INSTAGRAM_OAUTH_AUTHORIZE_URL=https://www.instagram.com/oauth/authorize
INSTAGRAM_OAUTH_TOKEN_URL=https://api.instagram.com/oauth/access_token
INSTAGRAM_GRAPH_API_URL=https://graph.instagram.com
INSTAGRAM_OAUTH_SCOPES=instagram_business_basic,instagram_business_manage_messages
INSTAGRAM_OAUTH_STATE_MAX_AGE=600
META_HTTP_TIMEOUT=15
META_WEBHOOK_MAX_BYTES=2097152
META_TOKEN_WARNING_DAYS=7
CRM_ATTACHMENT_MAX_BYTES=26214400
CRM_ATTACHMENT_MAX_REDIRECTS=3
CRM_ATTACHMENT_DELIVERY_TTL=300

# SMTP real. Activar SSL para 465 o TLS para 587, nunca ambos.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_SSL=False
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
EMAIL_TIMEOUT=20

# Firebase opcional. Use las variables individuales sin exponerlas al frontend.
FIREBASE_CREDENTIALS_FILE=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_CLIENT_ID=
FIREBASE_CLIENT_CERT_URL=

# Límites y throttling
DATA_UPLOAD_MAX_MEMORY_SIZE=26214400
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
DATA_UPLOAD_MAX_NUMBER_FIELDS=1000
THROTTLE_ANON_RATE=60/min
THROTTLE_USER_RATE=300/min
THROTTLE_LOGIN_RATE=5/min
THROTTLE_CHAT_RATE=20/min
THROTTLE_REVIEW_RATE=30/min
THROTTLE_PAYMENT_RATE=30/min
THROTTLE_FCM_RATE=30/min
THROTTLE_WOMPI_WEBHOOK_RATE=240/min
THROTTLE_META_WEBHOOK_RATE=600/min
THROTTLE_META_ADMIN_RATE=20/min

# Internal attachment origin; must match CRM_API_URL in gateway (8001 in production).
CRM_GATEWAY_MEDIA_BASE_URL=http://backend:8001
THROTTLE_CRM_UPLOAD_RATE=30/min

# TCC production remains off until a separate release is approved.
# Never reuse the development token in production or place secrets in VITE_*.
TCC_SHIPPING_ENABLED=False
TCC_API_ENVIRONMENT=production
TCC_DEVELOPMENT_BASE_URL=https://testsomos.tcc.com.co
TCC_PRODUCTION_BASE_URL=https://somos.tcc.com.co
TCC_API_TOKEN=
TCC_PRODUCTION_API_TOKEN=
TCC_PRODUCTION_APPROVED=False
TCC_DISPATCH_ENABLED=False
TCC_PQT_ACCOUNT=
TCC_MSJ_ACCOUNT=
TCC_ORIGIN_CITY_CODE=
TCC_SENDER_NAME=
TCC_SENDER_COMPANY=
TCC_SENDER_DOCUMENT_TYPE=
TCC_SENDER_DOCUMENT=
TCC_SENDER_ADDRESS=
TCC_SENDER_PHONE=
TCC_SENDER_EMAIL=
TCC_QUOTE_TTL_SECONDS=600
THROTTLE_SHIPPING_QUOTE_RATE=10/min
THROTTLE_SHIPPING_ESTIMATE_RATE=60/min
THROTTLE_SHIPPING_ADMIN_RATE=10/min

SERVER_EMAIL=ventas@imporgasjj.com
TRANSACTIONAL_REPLY_TO=ventas@imporgasjj.com
TRANSACTIONAL_EMAIL_ENABLED=False
PUBLIC_API_URL=https://www.imporgasjj.com/api
