# =============================================
# Variables de entorno para el servidor de correo
# Copia este archivo como .env y completa los valores
# =============================================

# Dominio del servidor de correo
MAIL_HOSTNAME=mail.tudominio.com

# ─── Relay externo (elige UNO) ───────────────

# Gmail — usa una App Password de Google (no la contraseña normal)
# Generala en: https://myaccount.google.com/apppasswords
# NOTA: puede ser bloqueada si la cuenta tiene restricciones de seguridad
#RELAYHOST=[smtp.gmail.com]:587
#SMTP_USER=luisstbean999@gmail.com
#SMTP_PASSWORD=rqazkihndrgwrnsm

# Brevo (recomendado — gratis 300 correos/día, sin restricciones)
# Regístrate en: https://app.brevo.com → Settings → SMTP & API
# RELAYHOST=[smtp-relay.brevo.com]:587
# SMTP_USER=tu_correo@ejemplo.com
# SMTP_PASSWORD=tu_smtp_key_de_brevo

# Outlook / Office 365
# RELAYHOST=[smtp.office365.com]:587
# SMTP_USER=tu_correo@outlook.com
# SMTP_PASSWORD=tu_contraseña

# SendGrid (recomendado para producción)
# RELAYHOST=[smtp.sendgrid.net]:587
# SMTP_USER=apikey
# SMTP_PASSWORD=TU_SENDGRID_API_KEY

# Brevo / Sendinblue
# RELAYHOST=[smtp-relay.brevo.com]:587
# SMTP_USER=tu_correo@ejemplo.com
# SMTP_PASSWORD=tu_clave_smtp_brevo
